---
import "../styles/tokens.css";
import "../styles/global.css";
import ThemeToggle from "../components/ThemeToggle.astro";
import { site, categories, abs } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  jsonLd?: unknown;
}
const { title, description = site.description, canonical = Astro.url.pathname, image, jsonLd } = Astro.props;
// abs() appends to the production base URL (keeps the /blog-ai path on Pages).
const canonicalUrl = abs(canonical);
const ogImage = abs(image ?? "/og-default.svg");
const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isActive = (href: string) => pathname === href.replace(/\/$/, "") || pathname.startsWith(href.replace(/\/$/, "") + "/");
const navItems = Object.entries(categories).slice(0, 5).map(([slug, c]) => ({ href: `/categories/${slug}`, label: c.title }));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {site.noindex && <meta name="robots" content="noindex, nofollow" />}
    {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Bodoni:wght@400;500;600;700&family=Public+Sans:wght@300;400;500;600;700&display=swap"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <!-- No-flash theme: run before paint -->
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.setAttribute("data-theme", t);
      } catch {}
      // Arm scroll-reveal only with JS + motion allowed (crawlers/no-JS see final state)
      try {
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("reveal-ready");
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col antialiased">
    <header class="sticky top-0 z-30 border-b border-border bg-bg/80 backdrop-blur-md">
      <div class="container-wide flex h-16 items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 font-display text-xl font-bold tracking-tight">
          <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand text-brand-ink">S</span>
          {site.name}
        </a>
        <nav class="hidden items-center gap-1 text-sm font-medium md:flex" aria-label="Primary">
          {navItems.map((it) => (
            <a href={it.href} aria-current={isActive(it.href) ? "page" : undefined}
               class:list={["relative rounded-md px-3 py-2 transition-colors after:absolute after:inset-x-3 after:-bottom-px after:h-0.5 after:origin-left after:scale-x-0 after:bg-cta after:transition-transform hover:text-ink hover:after:scale-x-100", isActive(it.href) ? "text-ink after:scale-x-100" : "text-muted"]}>
              {it.label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-2">
          <form action="/search/" role="search" class="hidden items-center sm:flex">
            <label class="relative">
              <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
              <input name="q" type="search" placeholder="Search" aria-label="Search reviews" class="w-36 rounded-full border border-border bg-surface py-1.5 pl-9 pr-3 text-sm outline-none transition-[width,border] focus:w-56 focus:border-cta" />
            </label>
          </form>
          <a href="/how-we-test" class:list={["hidden text-sm font-medium transition-colors hover:text-ink md:inline", isActive("/how-we-test") ? "text-ink" : "text-muted"]}>How we test</a>
          <ThemeToggle />
          <!-- Mobile menu toggle -->
          <button id="nav-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"
                  class="grid h-9 w-9 place-items-center rounded-full border border-border bg-surface text-ink transition-colors hover:border-cta md:hidden">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          </button>
        </div>
      </div>
      <!-- Mobile menu panel -->
      <div id="mobile-menu" hidden class="border-t border-border bg-bg md:hidden">
        <nav class="container-wide flex flex-col py-2" aria-label="Mobile">
          <form action="/search/" role="search" class="relative my-2">
            <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
            <input name="q" type="search" placeholder="Search reviews" aria-label="Search reviews" class="w-full rounded-lg border border-border bg-surface py-2.5 pl-9 pr-3 text-sm outline-none focus:border-cta" />
          </form>
          {navItems.map((it) => (
            <a href={it.href} aria-current={isActive(it.href) ? "page" : undefined}
               class:list={["flex items-center justify-between rounded-lg px-3 py-3 text-base font-medium", isActive(it.href) ? "bg-surface-2 text-ink" : "text-ink/90 hover:bg-surface-2"]}>
              {it.label}
              <span aria-hidden="true" class="text-muted">›</span>
            </a>
          ))}
          <a href="/how-we-test" class="rounded-lg px-3 py-3 text-base font-medium text-ink/90 hover:bg-surface-2">How we test</a>
        </nav>
      </div>
    </header>
    <script is:inline>
      (() => {
        const btn = document.getElementById("nav-toggle");
        const menu = document.getElementById("mobile-menu");
        if (!btn || !menu) return;
        btn.addEventListener("click", () => {
          const open = menu.hasAttribute("hidden");
          if (open) { menu.removeAttribute("hidden"); btn.setAttribute("aria-expanded", "true"); btn.setAttribute("aria-label", "Close menu"); }
          else { menu.setAttribute("hidden", ""); btn.setAttribute("aria-expanded", "false"); btn.setAttribute("aria-label", "Open menu"); }
        });
      })();
    </script>

    <main class="flex-1"><slot /></main>
    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains("reveal-ready")) return;
        const els = document.querySelectorAll(".reveal");
        if (!els.length || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("in"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
        }, { rootMargin: "0px 0px -8% 0px", threshold: 0.05 });
        els.forEach((el) => io.observe(el));
      })();
    </script>

    <footer class="mt-20 border-t border-border bg-surface-2/40">
      <div class="container-wide grid gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
        <div>
          <p class="mb-2 font-display text-lg font-bold">{site.name}</p>
          <p class="max-w-xs text-sm text-muted">{site.tagline}</p>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Categories</p>
          <ul class="flex flex-col gap-2 text-sm">
            {Object.entries(categories).map(([slug, c]) => (
              <li><a href={`/categories/${slug}`} class="text-muted hover:text-ink">{c.title}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Company</p>
          <ul class="flex flex-col gap-2 text-sm">
            <li><a href="/about" class="text-muted hover:text-ink">About</a></li>
            <li><a href="/how-we-test" class="text-muted hover:text-ink">How we test</a></li>
            <li><a href="/disclosure" class="text-muted hover:text-ink">Affiliate disclosure</a></li>
            <li><a href="/privacy" class="text-muted hover:text-ink">Privacy</a></li>
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-muted">Trust</p>
          <p class="text-sm text-muted">Independently funded. We buy the tools we review and may earn affiliate commissions. Rankings are never for sale.</p>
        </div>
      </div>
      <div class="container-wide border-t border-border py-6 text-xs text-muted">
        © {new Date().getFullYear()} {site.name}. All reviews reflect hands-on testing.
      </div>
    </footer>
  </body>
</html>
