---
import Logo from "./Logo.astro";
import CTAButton from "./CTAButton.astro";
import { go } from "../lib/site";

interface Props { article: any; }
const { article } = Astro.props;
const [a, b] = article.products;
const rows = article.scorecard?.rows ?? [];
const avg = (key: "a" | "b", fallback: number) =>
  rows.length ? Math.round((rows.reduce((s: number, r: any) => s + r[key], 0) / rows.length) * 10) / 10 : fallback * 2;
const scoreA = avg("a", a.rating);
const scoreB = avg("b", b.rating);
const cheapest = (p: any) => p.pricing?.reduce((lo: any, x: any) => (num(x.price) < num(lo.price) ? x : lo), p.pricing?.[0])?.price;
function num(s: string) { const n = Number(String(s).replace(/[^0-9.]/g, "")); return Number.isFinite(n) ? n : Infinity; }

// No single "winner" crown — this is a genuine "depends". Each tool wins a role.
const sides = [
  { p: a, score: scoreA, block: "hero-a", accent: "rgb(var(--brand))" },
  { p: b, score: scoreB, block: "hero-b", accent: "#f59e0b" },
];
---
<section aria-label="Head to head" class="not-prose">
  <div class="grid items-stretch gap-4 sm:grid-cols-[1fr_auto_1fr]">
    <div class="relative flex flex-col items-center rounded-xl2 border border-border bg-surface p-6 pt-8 text-center shadow-card">
      {sides[0].p.award && (
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow" style={`background:${sides[0].accent}`}>★ {sides[0].p.award}</span>
      )}
      <Logo name={sides[0].p.name} size={56} />
      <h3 class="mt-3 text-xl font-bold">{sides[0].p.name}</h3>
      <p class="text-sm text-muted">{sides[0].p.tagline}</p>
      <div class="my-4 flex items-end justify-center gap-1">
        <span class="font-display text-5xl font-bold tabular-nums" style={`color:${sides[0].accent}`}>{sides[0].score.toFixed(1)}</span>
        <span class="mb-1 text-sm font-semibold text-muted">/10</span>
      </div>
      <div class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-muted">
        <span>From <b class="text-ink">{cheapest(sides[0].p)}</b></span><span aria-hidden="true">·</span><span><b class="text-ink">{sides[0].p.pricing?.length ?? 0}</b> plans</span>
      </div>
      <CTAButton href={go(sides[0].p.id, article.slug, sides[0].block)} label={`Try ${sides[0].p.name}`} sub={`from ${cheapest(sides[0].p)}`} />
    </div>

    <div class="flex items-center justify-center">
      <span class="grid h-14 w-14 place-items-center rounded-full border border-border bg-bg font-display text-lg font-bold text-muted shadow-card">VS</span>
    </div>

    <div class="relative flex flex-col items-center rounded-xl2 border border-border bg-surface p-6 pt-8 text-center shadow-card">
      {sides[1].p.award && (
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-3 py-1 text-xs font-bold uppercase tracking-wide text-white shadow" style={`background:${sides[1].accent}`}>★ {sides[1].p.award}</span>
      )}
      <Logo name={sides[1].p.name} size={56} />
      <h3 class="mt-3 text-xl font-bold">{sides[1].p.name}</h3>
      <p class="text-sm text-muted">{sides[1].p.tagline}</p>
      <div class="my-4 flex items-end justify-center gap-1">
        <span class="font-display text-5xl font-bold tabular-nums" style={`color:${sides[1].accent}`}>{sides[1].score.toFixed(1)}</span>
        <span class="mb-1 text-sm font-semibold text-muted">/10</span>
      </div>
      <div class="mb-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs text-muted">
        <span>From <b class="text-ink">{cheapest(sides[1].p)}</b></span><span aria-hidden="true">·</span><span><b class="text-ink">{sides[1].p.pricing?.length ?? 0}</b> plans</span>
      </div>
      <CTAButton href={go(sides[1].p.id, article.slug, sides[1].block)} label={`Try ${sides[1].p.name}`} sub={`from ${cheapest(sides[1].p)}`} />
    </div>
  </div>
  {article.heroNote && (
    <p class="mx-auto mt-4 max-w-2xl text-center text-sm text-muted" set:html={article.heroNote} />
  )}
</section>
