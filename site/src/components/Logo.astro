---
// Brand-styled monogram used when a product has no logo asset — avoids stock images.
interface Props { name: string; size?: number; }
const { name, size = 44 } = Astro.props;
const initials = name.split(/\s+/).map((w) => w[0]).slice(0, 2).join("").toUpperCase();
const hue = [...name].reduce((h, c) => (h * 31 + c.charCodeAt(0)) % 360, 7);
---
<span
  class="grid place-items-center rounded-xl font-display font-semibold text-white shadow-card"
  style={`width:${size}px;height:${size}px;font-size:${size * 0.4}px;background:linear-gradient(135deg,hsl(${hue} 70% 52%),hsl(${(hue + 40) % 360} 70% 42%))`}
  aria-hidden="true"
>{initials}</span>
