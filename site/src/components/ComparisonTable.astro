---
import CTAButton from "./CTAButton.astro";
import Logo from "./Logo.astro";
import { go } from "../lib/site";

interface Props { article: any; }
const { article } = Astro.props;
const { columns, rows } = article.comparison;
const byId = (id: string) => article.products.find((p: any) => p.id === id);
---
<section aria-label="Side-by-side comparison" class="not-prose">
  <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">Side by side</h2>

  <!-- Desktop: real table -->
  <div class="hidden overflow-hidden rounded-xl2 border border-border md:block">
    <table class="w-full border-collapse text-sm">
      <thead>
        <tr class="bg-surface-2 text-left">
          <th class="px-4 py-3 font-semibold">Tool</th>
          {columns.map((c: string) => <th class="px-4 py-3 font-semibold">{c}</th>)}
          <th class="px-4 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row: any) => {
          const p = byId(row.productId);
          return (
            <tr class="border-t border-border even:bg-surface-2/40">
              <td class="px-4 py-3">
                <div class="flex items-center gap-2.5">
                  <Logo name={p.name} size={28} />
                  <span class="font-semibold">{p.name}</span>
                </div>
              </td>
              {row.values.map((v: string) => <td class="px-4 py-3 text-ink/85">{v}</td>)}
              <td class="px-4 py-3 text-right">
                <CTAButton href={go(p.id, article.slug, "table")} label="Check price" small />
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Mobile: cards -->
  <div class="flex flex-col gap-3 md:hidden">
    {rows.map((row: any) => {
      const p = byId(row.productId);
      return (
        <div class="card p-4">
          <div class="mb-3 flex items-center gap-2.5">
            <Logo name={p.name} size={32} />
            <span class="font-semibold">{p.name}</span>
          </div>
          <dl class="grid grid-cols-2 gap-x-3 gap-y-2 text-sm">
            {columns.map((c: string, i: number) => (
              <>
                <dt class="text-muted">{c}</dt>
                <dd class="text-right font-medium">{row.values[i]}</dd>
              </>
            ))}
          </dl>
          <div class="mt-3"><CTAButton href={go(p.id, article.slug, "table")} label="Check price" small /></div>
        </div>
      );
    })}
  </div>
</section>
