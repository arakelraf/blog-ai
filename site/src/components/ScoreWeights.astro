---
import { go } from "../lib/site";
interface Props { article: any; }
const { article } = Astro.props;
const [a, b] = article.products;
const rows = article.scorecard?.rows ?? [];
if (!rows.length) return;

// Role presets map category label -> weight (0 skip · 1 low · 2 normal · 3 high).
const presets: Record<string, Record<string, number>> = {
  "Link builder": { "Backlink data & accuracy": 3, "International coverage": 2, "Ease of use": 2, "Data size & freshness": 2, "All-in-one features": 0, "Reporting & agency tools": 0, "Keyword research": 2, "Value for money": 1 },
  "Agency / team": { "All-in-one features": 3, "Reporting & agency tools": 3, "Keyword research": 2, "Backlink data & accuracy": 2, "Value for money": 1, "Ease of use": 1, "Data size & freshness": 1, "International coverage": 1 },
  "Solo / budget": { "Value for money": 3, "Ease of use": 3, "Keyword research": 2, "Backlink data & accuracy": 2, "All-in-one features": 1, "International coverage": 1, "Data size & freshness": 1, "Reporting & agency tools": 0 },
};
const payload = {
  a: a.name, b: b.name, rows, presets,
  hrefA: go(a.id, article.slug, "weights"), hrefB: go(b.id, article.slug, "weights"),
};
---
<section class="not-prose">
  <div class="overflow-hidden rounded-xl2 border border-border bg-gradient-to-br from-brand/[0.07] via-surface to-surface-2 p-5 sm:p-7" id="sw-root">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <span class="text-sm font-semibold uppercase tracking-wide text-brand">Interactive</span>
        <h2 class="mt-1 text-2xl font-semibold sm:text-3xl">Build your own verdict</h2>
        <p class="mt-1 max-w-prose text-muted">Our overall score weights every category equally. Yours shouldn't. Set what matters to <em>you</em> and the winner recalculates live.</p>
      </div>
    </div>

    <!-- Live scoreboard -->
    <div class="mt-5 grid grid-cols-2 gap-3 sm:max-w-md">
      <div class="rounded-xl border border-border bg-surface p-4 text-center" data-score-card="a">
        <p class="truncate text-sm font-semibold" style="color:rgb(var(--brand))">{a.name}</p>
        <p class="mt-1 font-display text-4xl font-bold tabular-nums" style="color:rgb(var(--brand))" data-score="a">8.6</p>
        <p class="text-xs font-medium text-muted" data-tag="a">&nbsp;</p>
      </div>
      <div class="rounded-xl border border-border bg-surface p-4 text-center" data-score-card="b">
        <p class="truncate text-sm font-semibold" style="color:#f59e0b">{b.name}</p>
        <p class="mt-1 font-display text-4xl font-bold tabular-nums" style="color:#f59e0b" data-score="b">8.3</p>
        <p class="text-xs font-medium text-muted" data-tag="b">&nbsp;</p>
      </div>
    </div>
    <p class="mt-3 text-sm font-medium" data-verdict>&nbsp;</p>

    <!-- Payoff: a CTA tuned to the reader's own winner + a next step for the undecided -->
    <div class="mt-4 hidden flex-col items-stretch gap-3 rounded-xl border border-border bg-surface p-4 sm:flex-row sm:items-center" data-cta-wrap>
      <div class="flex-1">
        <p class="text-sm text-ink" data-cta-line></p>
        <a href="#deep-dive" class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:underline">Still deciding? See the full breakdown
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </a>
      </div>
      <a data-cta href="#" rel="sponsored nofollow" target="_blank" class="btn-cta shrink-0"><span data-cta-label>Try it</span></a>
    </div>

    <!-- Presets -->
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wide text-muted">Quick start:</span>
      <button type="button" class="sw-preset rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold transition-colors hover:border-brand hover:text-brand" data-preset="Link builder">Link builder</button>
      <button type="button" class="sw-preset rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold transition-colors hover:border-brand hover:text-brand" data-preset="Agency / team">Agency / team</button>
      <button type="button" class="sw-preset rounded-full border border-border bg-surface px-3 py-1.5 text-xs font-semibold transition-colors hover:border-brand hover:text-brand" data-preset="Solo / budget">Solo / budget</button>
      <button type="button" class="sw-reset rounded-full px-3 py-1.5 text-xs font-semibold text-muted underline-offset-2 hover:text-ink hover:underline">Reset</button>
    </div>

    <!-- Category weight controls -->
    <div class="mt-5 grid gap-2.5 sm:grid-cols-2" data-rows></div>

    <p class="mt-5 text-xs text-muted">Weights: Skip · Low · Normal · High. Scores come from our hands-on tests and don't change. You only set how much each category counts toward the total.</p>
  </div>

  <script type="application/json" id="sw-data" set:html={JSON.stringify(payload)}></script>
  <script is:inline>
    (() => {
      const root = document.getElementById("sw-root");
      if (!root) return;
      const data = JSON.parse(document.getElementById("sw-data").textContent);
      const LABELS = ["Skip", "Low", "Normal", "High"];
      const state = data.rows.map(() => 2); // default Normal

      const rowsWrap = root.querySelector("[data-rows]");
      data.rows.forEach((r, i) => {
        const row = document.createElement("div");
        row.className = "rounded-xl border border-border bg-surface p-3";
        row.innerHTML =
          '<div class="flex items-center justify-between gap-2">' +
          '<span class="text-sm font-semibold">' + r.label + '</span>' +
          '<span class="text-xs tabular-nums text-muted"><b style="color:rgb(var(--brand))">' + r.a.toFixed(1) + '</b> vs <b style="color:#f59e0b">' + r.b.toFixed(1) + '</b></span>' +
          '</div>' +
          '<div class="mt-2 grid grid-cols-4 gap-1" data-seg="' + i + '"></div>';
        rowsWrap.appendChild(row);
        const seg = row.querySelector("[data-seg]");
        LABELS.forEach((lab, w) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = lab;
          btn.dataset.w = String(w);
          btn.className = "rounded-md px-2 py-1.5 text-xs font-semibold transition-colors";
          btn.addEventListener("click", () => { state[i] = w; paint(); recalc(); });
          seg.appendChild(btn);
        });
      });

      function paint() {
        root.querySelectorAll("[data-seg]").forEach((seg, i) => {
          seg.querySelectorAll("button").forEach((btn) => {
            const on = Number(btn.dataset.w) === state[i];
            btn.classList.toggle("bg-brand", on);
            btn.classList.toggle("text-brand-ink", on);
            btn.classList.toggle("bg-surface-2", !on);
            btn.classList.toggle("text-muted", !on);
          });
        });
      }

      function wavg(key) {
        let num = 0, den = 0;
        data.rows.forEach((r, i) => { num += r[key] * state[i]; den += state[i]; });
        return den ? num / den : 0;
      }

      function recalc() {
        const sa = wavg("a"), sb = wavg("b");
        const elA = root.querySelector('[data-score="a"]');
        const elB = root.querySelector('[data-score="b"]');
        const total = state.reduce((s, w) => s + w, 0);
        const ctaWrap = root.querySelector("[data-cta-wrap]");
        if (!total) {
          elA.textContent = "—"; elB.textContent = "—";
          root.querySelector("[data-verdict]").textContent = "Pick at least one category that matters to you.";
          ctaWrap.classList.add("hidden"); ctaWrap.classList.remove("flex");
          return;
        }
        elA.textContent = sa.toFixed(1);
        elB.textContent = sb.toFixed(1);
        const tagA = root.querySelector('[data-tag="a"]');
        const tagB = root.querySelector('[data-tag="b"]');
        const aWins = sa > sb, tie = Math.abs(sa - sb) < 0.05;
        tagA.textContent = tie ? "Tie" : aWins ? "★ Your winner" : "";
        tagB.textContent = tie ? "Tie" : !aWins ? "★ Your winner" : "";
        root.querySelector('[data-score-card="a"]').style.boxShadow = !tie && aWins ? "0 0 0 2px rgb(var(--brand))" : "none";
        root.querySelector('[data-score-card="b"]').style.boxShadow = !tie && !aWins ? "0 0 0 2px #f59e0b" : "none";
        const v = root.querySelector("[data-verdict]");
        // Payoff CTA
        const cta = root.querySelector("[data-cta]");
        const winName = tie ? data.a : aWins ? data.a : data.b;
        const winHref = tie ? data.hrefA : aWins ? data.hrefA : data.hrefB;
        ctaWrap.classList.remove("hidden"); ctaWrap.classList.add("flex");
        cta.href = winHref;
        root.querySelector("[data-cta-label]").textContent = "Try " + winName + " free";
        if (tie) { v.textContent = "Dead heat. For your priorities these two are a real toss-up."; v.style.color = "rgb(var(--muted))";
          root.querySelector("[data-cta-line]").innerHTML = "It's a tie, so start with the one that fits your budget. Most readers try <b>" + data.a + "</b> first.";
        } else {
          const win = aWins ? data.a : data.b;
          const by = Math.abs(sa - sb).toFixed(1);
          v.textContent = "For what you care about, " + win + " wins by " + by + " points.";
          v.style.color = aWins ? "rgb(var(--brand))" : "#b45309";
          root.querySelector("[data-cta-line]").innerHTML = "Based on your priorities, <b>" + win + "</b> is your match. Ready to see it in action?";
        }
      }

      root.querySelectorAll(".sw-preset").forEach((btn) => btn.addEventListener("click", () => {
        const p = data.presets[btn.dataset.preset];
        data.rows.forEach((r, i) => { state[i] = p[r.label] ?? 2; });
        paint(); recalc();
      }));
      root.querySelector(".sw-reset").addEventListener("click", () => { state.forEach((_, i) => state[i] = 2); paint(); recalc(); });

      paint(); recalc();
    })();
  </script>
</section>
