---
interface Props { faq: { q: string; a: string }[]; }
const { faq } = Astro.props;
---
<section aria-label="Frequently asked questions" class="not-prose">
  <h2 class="mb-4 text-2xl font-semibold sm:text-3xl">FAQ</h2>
  <div class="divide-y divide-border rounded-xl2 border border-border">
    {faq.map((f) => (
      <details class="group px-5 py-4">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold">
          {f.q}
          <span class="text-muted transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-muted">{f.a}</p>
      </details>
    ))}
  </div>
</section>
