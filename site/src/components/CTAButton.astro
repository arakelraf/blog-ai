---
interface Props {
  href: string;
  label?: string;
  sub?: string; // small line under the label, e.g. "from $29/mo"
  variant?: "cta" | "ghost";
  small?: boolean;
  block?: boolean; // full width
}
const { href, label = "Check price", sub, variant = "cta", small = false, block = false } = Astro.props;
const base = variant === "cta" ? "btn-cta" : "btn-ghost";
---
<a
  href={href}
  rel="sponsored nofollow"
  target="_blank"
  class={`group ${base} ${small ? "!px-4 !py-2.5 !text-[13px]" : ""} ${block ? "w-full" : ""} ${sub ? "flex-col !gap-0.5 !py-2.5" : ""}`}
>
  <span class="inline-flex items-center gap-2">
    <span>{label}</span>
    <svg aria-hidden="true" class="h-[1.05em] w-[1.05em] transition-transform duration-150 ease-out group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
  </span>
  {sub && <span class="text-[11px] font-medium uppercase tracking-wide opacity-75">{sub}</span>}
</a>
