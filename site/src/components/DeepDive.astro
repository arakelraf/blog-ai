---
interface Props { article: any; }
const { article } = Astro.props;
const sections = article.sections ?? [];
if (!sections.length) return;
const nameById = (id: string) => article.products.find((p: any) => p.id === id)?.name ?? id;
---
<section class="not-prose">
  <div class="mb-7">
    <span class="text-sm font-semibold uppercase tracking-wide text-brand">The deep dive</span>
    <h2 class="mt-1 text-2xl font-semibold sm:text-3xl">How they actually compare, category by category</h2>
    <p class="mt-2 max-w-prose text-muted">No fluff. This is the hands-on breakdown behind every score in the chart above.</p>
  </div>

  <div class="flex flex-col gap-12">
    {sections.map((s: any, i: number) => (
      <article class="scroll-mt-24" id={`dive-${i}`}>
        {s.kicker && <p class="text-xs font-semibold uppercase tracking-wide text-muted">{s.kicker}</p>}
        <h3 class="mt-1 text-xl font-bold sm:text-2xl">{s.heading}</h3>

        <div class="mt-4 grid gap-7 lg:grid-cols-[1fr_minmax(260px,340px)] lg:items-start">
          <div class="rich max-w-prose">
            {s.body.map((p: string) => <p set:html={p} />)}
            {s.pullQuote && (
              <blockquote class="my-6 border-l-4 border-brand pl-5">
                <p class="text-lg font-semibold italic leading-snug text-ink">{s.pullQuote}</p>
              </blockquote>
            )}
          </div>

          <div class="flex flex-col gap-4">
            {s.screenshot && (
              <figure class="overflow-hidden rounded-xl2 border border-border bg-surface shadow-card">
                <div class="flex items-center gap-1.5 border-b border-border bg-surface-2 px-3 py-2.5">
                  <span class="h-2.5 w-2.5 rounded-full bg-red-400/70"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-amber-400/70"></span>
                  <span class="h-2.5 w-2.5 rounded-full bg-emerald-400/70"></span>
                  {s.screenshot.browser && (
                    <span class="ml-2 truncate rounded-md bg-bg px-2 py-0.5 text-[11px] text-muted">{s.screenshot.browser}</span>
                  )}
                </div>
                <div class="flex aspect-[16/10] items-center justify-center bg-gradient-to-br from-surface-2 to-bg p-6 text-center">
                  <div>
                    <svg class="mx-auto mb-2 h-8 w-8 text-muted/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.6"/><path d="m4 18 5-5 4 4 3-3 4 4"/></svg>
                    <p class="text-xs font-medium text-muted">Screenshot slot</p>
                    <p class="mt-0.5 text-[11px] text-muted/70">{s.screenshot.caption}</p>
                  </div>
                </div>
                {s.screenshot.credit && (
                  <figcaption class="border-t border-border px-3 py-2 text-[11px] text-muted">{s.screenshot.credit}</figcaption>
                )}
              </figure>
            )}
            {s.takeaway && (
              <div class="rounded-xl2 border border-brand/30 bg-brand/5 p-4">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand">Who wins this round</p>
                <p class="mt-1 font-bold">{nameById(s.takeaway.winnerId)}</p>
                <p class="mt-1 text-sm text-muted">{s.takeaway.text}</p>
              </div>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
