---
interface Props { data: any; }
const { data } = Astro.props;
---
<section aria-label="How to choose" class="not-prose">
  <h2 class="mb-3 text-2xl font-semibold sm:text-3xl">How to choose</h2>
  <p class="prose-lead mb-6 max-w-prose">{data.intro}</p>
  <div class="grid gap-4 sm:grid-cols-2">
    {data.criteria.map((c: any, i: number) => (
      <div class="rounded-xl2 border border-border p-5">
        <span class="mb-2 inline-block font-display text-sm font-semibold text-brand">{String(i + 1).padStart(2, "0")}</span>
        <h3 class="mb-1.5 text-lg font-semibold">{c.title}</h3>
        <p class="text-sm leading-relaxed text-muted">{c.body}</p>
      </div>
    ))}
  </div>
</section>
