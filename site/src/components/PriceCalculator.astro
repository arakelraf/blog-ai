---
import { go } from "../lib/site";
interface Props { article: any; }
const { article } = Astro.props;
const [a, b] = article.products;
const num = (s: string) => Number(String(s).replace(/[^0-9.]/g, "")) || 0;
const mk = (p: any) => ({
  id: p.id,
  name: p.name,
  accent: p.id === a.id ? "rgb(var(--brand))" : "#f59e0b",
  plans: (p.pricing ?? []).map((t: any) => ({ plan: t.plan, price: num(t.price) })),
  addons: p.addons ?? [],
  href: go(p.id, article.slug, "calc"),
});
const payload = { a: mk(a), b: mk(b) };
---
<section class="not-prose">
  <div class="overflow-hidden rounded-xl2 border border-border bg-surface p-5 sm:p-7" id="pc-root">
    <span class="text-sm font-semibold uppercase tracking-wide text-brand">Interactive</span>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 class="mt-1 text-2xl font-semibold sm:text-3xl">Price calculator</h2>
        <p class="mt-1 max-w-prose text-muted">Pick a plan for each and see the real monthly and yearly cost side by side.</p>
      </div>
      <!-- Billing toggle -->
      <div class="inline-flex rounded-full border border-border bg-surface-2 p-1 text-sm font-semibold" role="group" aria-label="Billing period">
        <button type="button" data-bill="monthly" class="pc-bill rounded-full px-4 py-1.5 transition-colors">Monthly</button>
        <button type="button" data-bill="annual" class="pc-bill rounded-full px-4 py-1.5 transition-colors">Annual <span class="text-xs font-medium opacity-80">~17% off</span></button>
      </div>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2" data-cards></div>

    <div class="mt-4 rounded-xl border border-border bg-surface-2 p-4 text-center text-sm font-medium" data-diff>&nbsp;</div>
    <p class="mt-3 text-xs text-muted">List prices as of 2026. Annual figures are an estimate (both vendors discount roughly 17% for yearly billing) — always confirm the current price on each site before buying.</p>
  </div>

  <script type="application/json" id="pc-data" set:html={JSON.stringify(payload)}></script>
  <script is:inline>
    (() => {
      const root = document.getElementById("pc-root");
      if (!root) return;
      const data = JSON.parse(document.getElementById("pc-data").textContent);
      const ANNUAL = 0.83; // ~17% off estimate
      const st = { bill: "monthly", a: { plan: 0, addons: {} }, b: { plan: 0, addons: {} } };
      const fmt = (n) => "$" + Math.round(n).toLocaleString("en-US");

      const cards = root.querySelector("[data-cards]");
      ["a", "b"].forEach((k) => {
        const t = data[k];
        const card = document.createElement("div");
        card.className = "rounded-xl border border-border p-4";
        card.style.borderTopColor = t.accent;
        card.style.borderTopWidth = "3px";
        let html = '<p class="font-bold" style="color:' + t.accent + '">' + t.name + '</p>' +
          '<label class="mt-3 block text-xs font-semibold uppercase tracking-wide text-muted">Plan</label>' +
          '<div class="mt-1.5 flex flex-wrap gap-1.5" data-plans="' + k + '"></div>';
        if (t.addons.length) {
          html += '<div class="mt-3 space-y-1.5" data-addons="' + k + '"></div>';
        }
        html += '<div class="mt-4 border-t border-border pt-3">' +
          '<div class="flex items-baseline justify-between"><span class="text-sm text-muted">Per month</span><span class="font-display text-2xl font-bold tabular-nums" data-mo="' + k + '"></span></div>' +
          '<div class="flex items-baseline justify-between text-sm text-muted"><span>Per year</span><span class="font-semibold tabular-nums" data-yr="' + k + '"></span></div>' +
          '</div>' +
          '<a href="' + t.href + '" rel="sponsored nofollow" target="_blank" class="btn-cta mt-4 w-full">Check ' + t.name + ' price</a>';
        card.innerHTML = html;
        cards.appendChild(card);

        const plansWrap = card.querySelector('[data-plans="' + k + '"]');
        t.plans.forEach((pl, i) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.textContent = pl.plan;
          btn.className = "rounded-lg border border-border px-2.5 py-1.5 text-xs font-semibold transition-colors";
          btn.addEventListener("click", () => { st[k].plan = i; render(); });
          btn.dataset.pi = String(i);
          plansWrap.appendChild(btn);
        });

        if (t.addons.length) {
          const aw = card.querySelector('[data-addons="' + k + '"]');
          t.addons.forEach((ad, i) => {
            const id = "ad-" + k + "-" + i;
            const label = document.createElement("label");
            label.className = "flex cursor-pointer items-center justify-between gap-2 rounded-lg border border-border px-3 py-2 text-sm";
            label.innerHTML = '<span class="flex items-center gap-2"><input type="checkbox" id="' + id + '" class="h-4 w-4 accent-[rgb(var(--cta))]"> ' + ad.label + '</span><span class="text-xs font-semibold text-muted">+' + fmt(ad.price) + '/mo</span>';
            aw.appendChild(label);
            label.querySelector("input").addEventListener("change", (e) => { st[k].addons[i] = e.target.checked; render(); });
          });
        }
      });

      function monthly(k) {
        const t = data[k];
        let m = t.plans[st[k].plan]?.price ?? 0;
        t.addons.forEach((ad, i) => { if (st[k].addons[i]) m += ad.price; });
        return st.bill === "annual" ? m * ANNUAL : m;
      }

      function render() {
        root.querySelectorAll(".pc-bill").forEach((btn) => {
          const on = btn.dataset.bill === st.bill;
          btn.classList.toggle("bg-surface", on);
          btn.classList.toggle("shadow-sm", on);
          btn.classList.toggle("text-ink", on);
          btn.classList.toggle("text-muted", !on);
        });
        ["a", "b"].forEach((k) => {
          root.querySelectorAll('[data-plans="' + k + '"] button').forEach((btn) => {
            const on = Number(btn.dataset.pi) === st[k].plan;
            btn.classList.toggle("bg-brand", on);
            btn.classList.toggle("text-brand-ink", on);
            btn.classList.toggle("border-brand", on);
          });
          const m = monthly(k);
          root.querySelector('[data-mo="' + k + '"]').textContent = fmt(m) + (st.bill === "annual" ? "*" : "");
          root.querySelector('[data-yr="' + k + '"]').textContent = fmt(m * 12);
        });
        const ma = monthly("a"), mb = monthly("b");
        const diff = root.querySelector("[data-diff]");
        const d = Math.abs(ma - mb) * 12;
        if (d < 1) { diff.textContent = "Same yearly cost on these plans."; diff.style.color = "rgb(var(--muted))"; }
        else {
          const cheaper = ma < mb ? data.a.name : data.b.name;
          diff.innerHTML = '<b>' + cheaper + '</b> is ' + fmt(d) + ' cheaper per year with this setup.';
          diff.style.color = "rgb(var(--ink))";
        }
      }
      render();
    })();
  </script>
</section>
