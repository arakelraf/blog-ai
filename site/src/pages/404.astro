---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found">
  <div class="container-prose grid min-h-[50vh] place-items-center py-20 text-center">
    <div>
      <p class="font-display text-7xl font-bold text-brand">404</p>
      <h1 class="mt-3 text-2xl font-semibold">We couldn't find that page</h1>
      <p class="mt-2 text-muted">It may have moved, or never existed.</p>
      <a href="/" class="btn-cta mt-6">Back home →</a>
    </div>
  </div>
</BaseLayout>
