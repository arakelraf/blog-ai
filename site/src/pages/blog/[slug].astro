---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AffiliateDisclosure from "../../components/AffiliateDisclosure.astro";
import QuickPick from "../../components/QuickPick.astro";
import VersusHero from "../../components/VersusHero.astro";
import ScoreBars from "../../components/ScoreBars.astro";
import ScorecardRadar from "../../components/ScorecardRadar.astro";
import ScoreWeights from "../../components/ScoreWeights.astro";
import PricingChart from "../../components/PricingChart.astro";
import PriceCalculator from "../../components/PriceCalculator.astro";
import DeepDive from "../../components/DeepDive.astro";
import DecisionHelper from "../../components/DecisionHelper.astro";
import ComparisonTable from "../../components/ComparisonTable.astro";
import ProductReview from "../../components/ProductReview.astro";
import HowToChoose from "../../components/HowToChoose.astro";
import FAQ from "../../components/FAQ.astro";
import FinalVerdict from "../../components/FinalVerdict.astro";
import StickyCTA from "../../components/StickyCTA.astro";
import RelatedPosts from "../../components/RelatedPosts.astro";
import { articleJsonLd } from "../../lib/schema";
import { categories, abs } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("articles");
  return all.map((entry) => {
    const slug = entry.id.replace(/\.json$/, "");
    const related = all.filter((e) => entry.data.related.includes(e.id.replace(/\.json$/, "")));
    return { params: { slug }, props: { entry, slug, related } };
  });
}

const { entry, slug, related } = Astro.props;
const a = { ...entry.data, slug };
const canonical = `/blog/${slug}`;
const jsonLd = articleJsonLd(entry.data, abs(canonical));
const top = a.products.find((p: any) => p.id === a.quickPick.overall) ?? a.products[0];
const fmt = (d: Date) => new Date(d).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });
const catTitle = categories[a.categorySlug]?.title ?? a.category;
---
<BaseLayout title={a.metaTitle} description={a.metaDescription} canonical={canonical} image={`/og/${slug}.svg`} jsonLd={jsonLd}>
  <article>
    <!-- Hero -->
    <div class="container-prose pt-8">
      <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: catTitle, href: `/categories/${a.categorySlug}` }, { label: a.title }]} />
      {a.demo && (
        <p class="mt-4 rounded-lg border border-gold/40 bg-gold/10 px-3 py-2 text-xs font-semibold text-gold">
          DEMO PAGE — sample data for layout preview only. Products, prices and claims are fictional.
        </p>
      )}
      <span class="mt-5 inline-flex items-center gap-1.5 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand">
        <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>{catTitle}
      </span>
      <h1 class="mt-4 text-[2rem] font-bold leading-[1.08] tracking-tight sm:text-[3.25rem]">
        {a.titleAccent && a.title.includes(a.titleAccent) ? (
          <>
            {a.title.slice(0, a.title.indexOf(a.titleAccent))}
            <span class="bg-gradient-to-r from-brand to-[#f59e0b] bg-clip-text text-transparent">{a.titleAccent}</span>
            {a.title.slice(a.title.indexOf(a.titleAccent) + a.titleAccent.length)}
          </>
        ) : a.title}
      </h1>
      <p class="mt-5 prose-lead">{a.lead}</p>

      <!-- Trust chips -->
      <div class="mt-6 flex flex-wrap items-center gap-2 text-sm">
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 font-medium text-ink shadow-[0_1px_1px_rgb(0_0_0/0.03)]">
          <svg class="h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
          Hands-on tested
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 font-medium text-ink shadow-[0_1px_1px_rgb(0_0_0/0.03)]">
          <svg class="h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18M8 2v4M16 2v4"/></svg>
          Updated {fmt(a.updatedDate ?? a.publishDate)}
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 font-medium text-ink shadow-[0_1px_1px_rgb(0_0_0/0.03)]">
          <svg class="h-4 w-4 text-brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          {a.products.length} tools · 8 categories
        </span>
      </div>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
        <span>By <a href={`/authors/${a.authorSlug}`} class="font-medium text-ink hover:text-brand">{a.author}</a></span>
        <span aria-hidden="true">·</span>
        <AffiliateDisclosure compact />
      </div>
    </div>

    <!-- Body -->
    <div class="container-wide mt-12 flex flex-col gap-14 pb-10">
      {a.pageType === "versus" && a.products.length === 2 ? <VersusHero article={a} /> : <QuickPick article={a} />}
      {a.scorecard && <ScorecardRadar article={a} />}
      {a.scorecard && <ScoreBars article={a} />}
      {a.scorecard && <ScoreWeights article={a} />}
      {a.sections && a.sections.length > 0 && <DeepDive article={a} />}
      <PriceCalculator article={a} />
      <PricingChart article={a} />
      <ComparisonTable article={a} />

      <section class="not-prose">
        <h2 class="mb-6 text-2xl font-semibold sm:text-3xl">The reviews, in depth</h2>
        <div class="flex flex-col gap-6">
          {a.products.map((p: any, i: number) => <ProductReview product={p} slug={slug} index={i + 1} />)}
        </div>
      </section>

      <HowToChoose data={a.howToChoose} />
      {a.decision && <DecisionHelper article={a} />}
      <FAQ faq={a.faq} />
      <FinalVerdict article={a} />
      <RelatedPosts articles={related} />
    </div>
  </article>

  <StickyCTA product={top} slug={slug} />
</BaseLayout>
