---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories } from "../../lib/site";

export async function getStaticPaths() {
  const all = await getCollection("articles");
  return Object.entries(categories).map(([slug, meta]) => ({
    params: { category: slug },
    props: {
      meta,
      posts: all
        .filter((a) => a.data.categorySlug === slug)
        .map((a) => ({ ...a.data, slug: a.id.replace(/\.json$/, "") })),
    },
  }));
}
const { meta, posts } = Astro.props;
---
<BaseLayout title={`${meta.title} reviews`} description={meta.blurb}>
  <div class="container-wide py-10">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: meta.title }]} />
    <span class="mt-6 inline-flex items-center gap-1.5 rounded-full border border-brand/25 bg-brand/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-brand">
      <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>Category
    </span>
    <h1 class="mt-4 text-4xl font-bold leading-[1.05] sm:text-6xl">{meta.title}</h1>
    <p class="mt-4 max-w-2xl prose-lead">{meta.blurb}</p>

    <div class="mt-10 flex items-end justify-between border-t border-ink/15 pt-5">
      <div class="flex items-baseline gap-4">
        <span class="font-display text-xl font-bold tabular-nums text-cta">{String(posts.length).padStart(2, "0")}</span>
        <h2 class="text-xl font-semibold sm:text-2xl">{posts.length === 1 ? "Review" : "Reviews"}</h2>
      </div>
      <span class="hidden text-xs font-semibold uppercase tracking-[0.14em] text-muted sm:block">Hands-on tested</span>
    </div>

    <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {posts.length ? posts.map((a: any) => <ArticleCard article={a} />) : (
        <div class="col-span-full rounded-xl2 border border-dashed border-border bg-surface-2/50 px-6 py-16 text-center">
          <p class="font-display text-xl font-semibold">Nothing here yet</p>
          <p class="mx-auto mt-2 max-w-sm text-sm text-muted">We only publish after hands-on testing, so this category is still in the lab. Check back soon.</p>
          <a href="/" class="btn-ghost mt-5">Back to all reviews</a>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
