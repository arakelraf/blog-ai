---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
---
<BaseLayout title="Search" description="Search reviews and comparisons.">
  <div class="container-wide py-10">
    <Breadcrumbs items={[{ label: "Home", href: "/" }, { label: "Search" }]} />
    <h1 class="mt-4 text-4xl font-bold sm:text-5xl">Search</h1>
    <p class="mt-3 max-w-2xl prose-lead">Find a review, comparison or tool by name.</p>

    <div class="relative mt-8 max-w-xl">
      <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3" stroke-linecap="round"/></svg>
      <input
        id="q"
        type="search"
        autocomplete="off"
        placeholder="Try &ldquo;AI writing&rdquo;, &ldquo;SEO&rdquo;, or a tool name…"
        class="w-full rounded-full border border-border bg-surface py-3.5 pl-12 pr-4 text-base shadow-card outline-none transition-colors focus:border-brand"
      />
    </div>

    <p id="count" class="mt-6 text-sm text-muted"></p>
    <div id="results" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"></div>
    <p id="empty" class="mt-4 hidden text-muted">No matches. Try a broader term.</p>
  </div>

  <script is:inline>
    (() => {
      // Base-aware: works at root locally and under /blog-ai/ on GitHub Pages.
      const base = location.pathname.replace(/\/search(\/index\.html)?\/?$/, "") || "";
      const input = document.getElementById("q");
      const results = document.getElementById("results");
      const count = document.getElementById("count");
      const empty = document.getElementById("empty");
      let data = [];

      const esc = (s) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]);

      function card(item) {
        return `<a href="${base}/blog/${item.slug}" class="card group flex flex-col gap-2 p-5 transition-all hover:-translate-y-1 hover:shadow-pop">
          <span class="text-xs font-semibold uppercase tracking-wide text-brand">${esc(item.category)}</span>
          <h3 class="text-lg font-semibold leading-snug group-hover:text-brand">${esc(item.title)}</h3>
          <p class="line-clamp-2 text-sm text-muted">${esc(item.description)}</p>
        </a>`;
      }

      function render(q) {
        const query = q.trim().toLowerCase();
        let matches = data;
        if (query) {
          const terms = query.split(/\s+/);
          matches = data
            .map((item) => {
              let score = 0;
              for (const t of terms) {
                if (!item.haystack.includes(t)) return null;
                if (item.title.toLowerCase().includes(t)) score += 3;
                else if (item.category.toLowerCase().includes(t)) score += 2;
                else score += 1;
              }
              return { item, score };
            })
            .filter(Boolean)
            .sort((a, b) => b.score - a.score)
            .map((x) => x.item);
        }
        results.innerHTML = matches.map(card).join("");
        empty.classList.toggle("hidden", matches.length > 0);
        count.textContent = query
          ? `${matches.length} result${matches.length === 1 ? "" : "s"} for “${q.trim()}”`
          : `${data.length} reviews`;
      }

      fetch(`${base}/search-index.json`)
        .then((r) => r.json())
        .then((json) => {
          data = json;
          const params = new URLSearchParams(location.search);
          const q = params.get("q") || "";
          input.value = q;
          render(q);
          input.focus();
        })
        .catch(() => {
          count.textContent = "Search is unavailable right now.";
        });

      let t;
      input.addEventListener("input", () => {
        clearTimeout(t);
        t = setTimeout(() => {
          render(input.value);
          const u = new URL(location.href);
          input.value ? u.searchParams.set("q", input.value) : u.searchParams.delete("q");
          history.replaceState(null, "", u);
        }, 120);
      });
    })();
  </script>
</BaseLayout>
