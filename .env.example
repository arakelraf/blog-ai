# ───────────────────────────────────────────────────────────────
# blog-ai pipeline — environment
# Copy to pipeline/.env (or export in your shell / docker-compose).
# Any service whose keys are missing runs in MOCK mode automatically,
# so the pipeline always starts. Set MOCK=true to force mocks everywhere.
# ───────────────────────────────────────────────────────────────

PORT=3000
NODE_ENV=development
DATABASE_PATH=../db/blog.db
SITE_URL=https://example.com      # set your real domain when you have one
MOCK=false

# ── LLM (Anthropic) ──
# LLM_EFFORT is deliberately NOT named CLAUDE_EFFORT (that collides with host vars).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
LLM_EFFORT=low                    # low | medium | high | xhigh | max

# ── SEO data (DataForSEO) ──
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# ── Telegram (REVIEW mode previews + reports) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── GitHub (publishing commits the article JSON) ──
GITHUB_TOKEN=
GITHUB_REPO=arakelraf/blog-ai
GITHUB_BRANCH=main

# ── IndexNow (ping search engines after publish) ──
INDEXNOW_KEY=

# ── Admin page (affiliate management) ──
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
